# Обязательно
BOT_TOKEN=your_telegram_bot_token

# LLM — без ключа используется MockLLMService (заглушка)
GROQ_API_KEY=your_groq_api_key

# База данных — по умолчанию SQLite
DATABASE_URL=sqlite+aiosqlite:///examflow.db
# Для PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:pass@host/dbname

# Тайм-аут LLM-запросов в секундах (optional, default: 15)
LLM_TIMEOUT=15

# ID чата администратора для уведомлений об ошибках (optional)
ADMIN_CHAT_ID=
